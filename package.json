{
  "name": "moss-signing",
  "version": "0.1.1",
  "description": "MOSS SDK for TypeScript - Cryptographic signing for AI agent outputs",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    },
    "./partner": {
      "require": "./dist/partner/index.js",
      "import": "./dist/partner/index.mjs",
      "types": "./dist/partner/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/uninstall.ts src/partner/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts src/uninstall.ts src/partner/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist",
    "gen:openapi": "bash scripts/gen-openapi.sh",
    "gen:openapi:check": "bash scripts/gen-openapi.sh --check",
    "mock": "bash scripts/mock.sh",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "moss",
    "ai",
    "agents",
    "signing",
    "cryptography",
    "post-quantum",
    "ml-dsa",
    "dilithium",
    "attribution",
    "audit"
  ],
  "author": "IAMPASS Inc.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mosscomputing/moss-sdk-ts"
  },
  "homepage": "https://mosscomputing.com",
  "bugs": {
    "url": "https://github.com/mosscomputing/moss-sdk-ts/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@stoplight/prism-cli": "^5.14.2",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@noble/hashes": "^1.3.0",
    "@noble/post-quantum": "0.6.1",
    "vite": "^8.1.5"
  }
}
